{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "standupper-cleanup",
	"main": "index.ts",
	"compatibility_date": "2026-11-18",
	"workers_dev": false,
	"observability": { "enabled": true },
	"triggers": { "crons": ["0 8 * * *"] },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "standupper",
			"database_id": "6b15fdc0-4d7c-433b-b3b0-1cdafb160054"
		}
	]
}
